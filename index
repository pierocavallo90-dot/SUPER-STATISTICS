<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>BETBAR | Scouting Engine</title>
    
    <style>
        :root {
            --bg-base: #0f172a;
            --bg-panel: #1e293b;
            --bg-darker: #0b1120;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-blue: #38bdf8;
            --accent-gold: #fbbf24;
            --neon-green: #22c55e;
            --neon-red: #ef4444;
            --border-glow: rgba(56, 189, 248, 0.3);
        }

        * { box-sizing: border-box; font-family: 'Inter', -apple-system, sans-serif; }
        
        body { 
            margin: 0; padding: 0; background-color: var(--bg-base); color: var(--text-main); 
            min-height: 100vh; display: flex; flex-direction: column;
        }

        /* HEADER & SEARCH */
        .top-nav {
            background: var(--bg-darker); border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 15px 30px; display: flex; justify-content: space-between; align-items: center;
        }
        .logo { font-size: 1.5rem; font-weight: 900; letter-spacing: 2px; }
        .logo span { color: var(--accent-blue); }
        
        .search-container {
            display: flex; gap: 15px; background: var(--bg-panel); padding: 15px;
            border-radius: 12px; margin: 20px auto; max-width: 900px;
            border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .search-box { flex: 1; display: flex; flex-direction: column; gap: 5px; }
        .search-lbl { font-size: 0.75rem; color: var(--text-muted); font-weight: bold; text-transform: uppercase;}
        .search-input { background: var(--bg-darker); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px; border-radius: 6px; font-size: 1.1rem; font-weight: bold; outline: none;}
        .search-input:focus { border-color: var(--accent-blue); }
        .btn-scout { background: var(--accent-blue); color: #000; border: none; padding: 0 30px; border-radius: 6px; font-weight: 900; font-size: 1rem; text-transform: uppercase; cursor: pointer; transition: 0.2s;}
        .btn-scout:hover { box-shadow: 0 0 20px var(--border-glow); transform: translateY(-1px);}

        /* LOADER */
        .loader-container { display: none; text-align: center; padding: 50px; flex-direction: column; align-items: center; gap: 15px;}
        .spinner { width: 40px; height: 40px; border: 4px solid rgba(255,255,255,0.1); border-top-color: var(--accent-blue); border-radius: 50%; animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loader-text { color: var(--accent-blue); font-family: monospace; font-weight: bold; font-size: 0.9rem;}

        /* DASHBOARD (OUTPUT) */
        .dashboard { display: none; max-width: 1000px; margin: 0 auto; padding: 0 15px 40px 15px; width: 100%; animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .top-stats { display: flex; gap: 20px; margin-bottom: 20px; }
        
        /* TEAM CARDS */
        .team-card { flex: 1; background: var(--bg-panel); border-radius: 12px; padding: 20px; border: 1px solid rgba(255,255,255,0.05); }
        .tc-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;}
        .tc-name { font-size: 1.5rem; font-weight: 900; }
        .tc-rating { background: var(--bg-darker); padding: 5px 10px; border-radius: 6px; font-weight: bold; color: var(--accent-gold); border: 1px solid rgba(251,191,36,0.3);}
        
        .form-track { display: flex; gap: 5px; margin-bottom: 15px;}
        .form-badge { width: 25px; height: 25px; display: flex; align-items: center; justify-content: center; border-radius: 4px; font-size: 0.75rem; font-weight: bold; color: #fff;}
        .form-w { background: var(--neon-green); }
        .form-d { background: var(--text-muted); }
        .form-l { background: var(--neon-red); }

        .stat-bar-wrap { margin-bottom: 10px; }
        .stat-bar-lbl { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: bold; color: var(--text-muted); margin-bottom: 4px;}
        .stat-bar-bg { width: 100%; height: 8px; background: var(--bg-darker); border-radius: 4px; overflow: hidden; }
        .stat-bar-fill { height: 100%; background: var(--accent-blue); border-radius: 4px; transition: width 1s ease-out;}

        /* LA SENTENZA (GOLDEN BET) */
        .golden-bet-container {
            background: linear-gradient(145deg, var(--bg-panel), #151e2e);
            border: 2px solid var(--accent-gold);
            border-radius: 16px; padding: 30px; text-align: center;
            box-shadow: 0 10px 40px rgba(251, 191, 36, 0.15);
            margin-bottom: 20px; position: relative; overflow: hidden;
        }
        .gb-badge { position: absolute; top: 0; left: 50%; transform: translateX(-50%); background: var(--accent-gold); color: #000; padding: 4px 20px; font-weight: 900; font-size: 0.8rem; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; letter-spacing: 1px;}
        .gb-title { font-size: 1rem; color: var(--text-muted); font-weight: bold; text-transform: uppercase; margin-top: 10px; margin-bottom: 5px;}
        .gb-prediction { font-size: 3.5rem; font-weight: 900; color: #fff; margin: 0; line-height: 1.1; text-shadow: 0 0 20px rgba(255,255,255,0.2);}
        
        .gb-confidence { display: inline-flex; align-items: center; gap: 8px; margin-top: 15px; background: rgba(0,0,0,0.3); padding: 8px 15px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1);}
        .conf-circle { width: 12px; height: 12px; border-radius: 50%; }
        .conf-high { background: var(--neon-green); box-shadow: 0 0 10px var(--neon-green);}
        .conf-med { background: var(--accent-gold); box-shadow: 0 0 10px var(--accent-gold);}
        .conf-low { background: var(--neon-red); box-shadow: 0 0 10px var(--neon-red);}
        .conf-text { font-weight: bold; font-size: 0.9rem; }

        /* MOTIVAZIONI AI */
        .ai-analysis { background: var(--bg-panel); border-radius: 12px; padding: 25px; border: 1px solid rgba(255,255,255,0.05); }
        .ai-header { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; font-weight: 900; font-size: 1.1rem; color: var(--accent-blue);}
        .ai-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;}
        .ai-list li { display: flex; gap: 15px; background: var(--bg-darker); padding: 15px; border-radius: 8px; border-left: 3px solid var(--accent-blue); font-size: 0.95rem; line-height: 1.4;}
        .ai-list li::before { content: '🤖'; font-size: 1.2rem; }

    </style>
</head>
<body>

    <div class="top-nav">
        <div class="logo">BETBAR<span>SCOUT</span></div>
        <div style="font-size: 0.8rem; color:var(--text-muted); font-weight:bold;">Powered by Algoritmo Ponderato v1.0</div>
    </div>

    <!-- AREA RICERCA -->
    <div class="search-container">
        <div class="search-box">
            <span class="search-lbl">Squadra Casa</span>
            <input type="text" id="input-home" class="search-input" placeholder="Es. Chelsea" value="Chelsea">
        </div>
        <div class="search-box">
            <span class="search-lbl">Squadra Ospite</span>
            <input type="text" id="input-away" class="search-input" placeholder="Es. Arsenal">
        </div>
        <button class="btn-scout" onclick="runScoutingEngine()">Inizia Scouting</button>
    </div>

    <!-- LOADER -->
    <div class="loader-container" id="loader">
        <div class="spinner"></div>
        <div class="loader-text" id="loader-log">Connessione API Sofascore in corso...</div>
    </div>

    <!-- DASHBOARD OUTPUT -->
    <div class="dashboard" id="dashboard">
        
        <!-- CARD SQUADRE -->
        <div class="top-stats">
            <!-- HOME CARD -->
            <div class="team-card">
                <div class="tc-header">
                    <div class="tc-name" id="ui-home-name">Team A</div>
                    <div class="tc-rating" id="ui-home-rating">★ 0.00</div>
                </div>
                <div style="font-size: 0.7rem; color:var(--text-muted); font-weight:bold; margin-bottom:5px; text-transform:uppercase;">Forma (Ultime 5)</div>
                <div class="form-track" id="ui-home-form"></div>
                
                <div class="stat-bar-wrap" style="margin-top:20px;">
                    <div class="stat-bar-lbl"><span>Power Index (Attacco)</span><span id="ui-home-atk-val">0%</span></div>
                    <div class="stat-bar-bg"><div class="stat-bar-fill" id="ui-home-atk-bar" style="width: 0%; background: var(--accent-blue);"></div></div>
                </div>
                <div class="stat-bar-wrap">
                    <div class="stat-bar-lbl"><span>Solidità (Difesa)</span><span id="ui-home-def-val">0%</span></div>
                    <div class="stat-bar-bg"><div class="stat-bar-fill" id="ui-home-def-bar" style="width: 0%; background: var(--neon-green);"></div></div>
                </div>
            </div>

            <!-- AWAY CARD -->
            <div class="team-card">
                <div class="tc-header">
                    <div class="tc-name" id="ui-away-name">Team B</div>
                    <div class="tc-rating" id="ui-away-rating">★ 0.00</div>
                </div>
                <div style="font-size: 0.7rem; color:var(--text-muted); font-weight:bold; margin-bottom:5px; text-transform:uppercase;">Forma (Ultime 5)</div>
                <div class="form-track" id="ui-away-form"></div>
                
                <div class="stat-bar-wrap" style="margin-top:20px;">
                    <div class="stat-bar-lbl"><span>Power Index (Attacco)</span><span id="ui-away-atk-val">0%</span></div>
                    <div class="stat-bar-bg"><div class="stat-bar-fill" id="ui-away-atk-bar" style="width: 0%; background: var(--accent-blue);"></div></div>
                </div>
                <div class="stat-bar-wrap">
                    <div class="stat-bar-lbl"><span>Solidità (Difesa)</span><span id="ui-away-def-val">0%</span></div>
                    <div class="stat-bar-bg"><div class="stat-bar-fill" id="ui-away-def-bar" style="width: 0%; background: var(--neon-green);"></div></div>
                </div>
            </div>
        </div>

        <!-- LA SENTENZA -->
        <div class="golden-bet-container">
            <div class="gb-badge">LA SENTENZA</div>
            <div class="gb-title">GIOCATA A PIÙ ALTO VALORE MATEMATICO</div>
            <div class="gb-prediction" id="ui-prediction">-</div>
            
            <div class="gb-confidence">
                <div class="conf-circle" id="ui-conf-circle"></div>
                <div class="conf-text" id="ui-conf-text">Fiducia: 0%</div>
            </div>
        </div>

        <!-- MOTIVAZIONI AI -->
        <div class="ai-analysis">
            <div class="ai-header">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Motivazioni Algoritmo
            </div>
            <ul class="ai-list" id="ui-ai-reasons">
                <!-- Generati da JS -->
            </ul>
        </div>

    </div>

    <script>
        // ==========================================
        // 1. PROVIDER DATI (Simulatore API Sofascore)
        // ==========================================
        // Qui andrà la logica fetch() con la chiave RapidAPI. 
        // Per ora simuliamo i dati usando il JSON reale che hai fornito.

        const mockSofascoreData = {
            home: {
                team: { name: "Chelsea" },
                pregameForm: { avgRating: 7.36, form: ["W", "L", "D", "L", "W"] },
                stats: { goalsScored: 2.1, goalsConceded: 1.2 } // Dati extra simulati necessari all'algoritmo
            },
            away: {
                team: { name: "Arsenal" },
                pregameForm: { avgRating: 7.15, form: ["D", "D", "W", "L", "D"] },
                stats: { goalsScored: 1.4, goalsConceded: 1.5 }
            }
        };

        // ==========================================
        // 2. IL MOTORE (Algoritmo Ponderato)
        // ==========================================
        const ScoutingEngine = {
            
            // Converte l'array di forma in un moltiplicatore di Momentum
            calcMomentum: function(formArray) {
                let pts = 0;
                let multiplier = 1; // Pesa di più le partite più recenti (l'ultima a destra)
                formArray.forEach((res, index) => {
                    let weight = 1 + (index * 0.1); 
                    if(res === 'W') pts += 3 * weight;
                    if(res === 'D') pts += 1 * weight;
                });
                // Ritorna un valore da 0 a 100
                return Math.min(100, Math.max(10, (pts / 18) * 100)); 
            },

            analyze: function(home, away) {
                // Estrazione dati puliti
                const hForm = this.calcMomentum(home.pregameForm.form);
                const aForm = this.calcMomentum(away.pregameForm.form);
                const hRate = home.pregameForm.avgRating;
                const aRate = away.pregameForm.avgRating;

                // Modulo Potenza di Fuoco (Power Index)
                const hPower = ((hRate * 10) * 0.6) + (hForm * 0.4);
                const aPower = ((aRate * 10) * 0.6) + (aForm * 0.4);

                // Modulo Gol (xG Sintetico)
                const expGoalsHome = (home.stats.goalsScored + away.stats.goalsConceded) / 2;
                const expGoalsAway = (away.stats.goalsScored + home.stats.goalsConceded) / 2;
                const totalExpGoals = expGoalsHome + expGoalsAway;

                // Costruzione della Golden Bet
                let prediction = "";
                let confidence = 0;
                let reasons = [];

                // Logica 1X2 / Doppia Chance
                let diff = hPower - aPower;
                
                if (diff > 12) {
                    prediction = "1";
                    confidence = 75 + (diff / 2);
                    reasons.push(`Il ${home.team.name} ha un Power Index nettamente superiore (${hPower.toFixed(1)} vs ${aPower.toFixed(1)}).`);
                } else if (diff < -12) {
                    prediction = "2";
                    confidence = 75 + (Math.abs(diff) / 2);
                    reasons.push(`L'${away.team.name} domina il differenziale di rating e stato di forma recente.`);
                } else {
                    // Match Equilibrato
                    prediction = diff > 0 ? "1X" : "X2";
                    confidence = 70 - Math.abs(diff);
                    reasons.push(`Match sul filo del rasoio (Differenziale forma solo di ${Math.abs(diff).toFixed(1)} punti). Copertura consigliata.`);
                }

                // Logica Gol
                if (totalExpGoals > 2.8) {
                    prediction += " + OVER 2.5";
                    confidence += 8;
                    reasons.push(`I dati incrociati prevedono un xG Sintetico di ${totalExpGoals.toFixed(2)} gol totali nel match.`);
                } else if (totalExpGoals < 2.0) {
                    prediction += " + UNDER 2.5";
                    confidence += 8;
                    reasons.push(`Fase difensiva solida per entrambe. xG Sintetico proiettato sotto i 2 gol.`);
                } else if (expGoalsHome >= 1.1 && expGoalsAway >= 1.1) {
                    prediction += " + GOL (GG)";
                    confidence += 5;
                    reasons.push(`Entrambe le squadre hanno una media gol/subiti che giustifica l'esito GOL.`);
                }

                // Tetto massimo fiducia 95%
                confidence = Math.min(95, confidence);

                return {
                    hPower: hPower, aPower: aPower,
                    hDef: 100 - (home.stats.goalsConceded * 25), // Statistica difensiva invertita per visualizzazione
                    aDef: 100 - (away.stats.goalsConceded * 25),
                    prediction: prediction,
                    confidence: confidence,
                    reasons: reasons
                };
            }
        };

        // ==========================================
        // 3. LOGICA DI CONTROLLO INTERFACCIA
        // ==========================================
        function runScoutingEngine() {
            let hInput = document.getElementById('input-home').value;
            let aInput = document.getElementById('input-away').value;
            
            if(!hInput || !aInput) { alert("Inserisci le squadre."); return; }

            // Nascondi dashboard e mostra loader
            document.getElementById('dashboard').style.display = 'none';
            const loader = document.getElementById('loader');
            const log = document.getElementById('loader-log');
            loader.style.display = 'flex';

            // Sequenza di log finti per creare l'effetto "Analisi in corso"
            setTimeout(() => log.textContent = "Estrazione Rating e PregameForm...", 600);
            setTimeout(() => log.textContent = "Calcolo Momentum e xG Sintetico...", 1400);
            setTimeout(() => log.textContent = "Generazione Golden Bet...", 2200);

            setTimeout(() => {
                // IN FUTURO QUI CI SARA' LA FETCH() A RAPIDAPI.
                // Usiamo i mock data
                let homeData = mockSofascoreData.home;
                let awayData = mockSofascoreData.away;
                
                // Sovrascrivo i nomi per UX
                homeData.team.name = hInput;
                awayData.team.name = aInput;

                // Eseguo il calcolo algoritmico
                let analysis = ScoutingEngine.analyze(homeData, awayData);
                
                // Disegno la UI
                renderDashboard(homeData, awayData, analysis);

                loader.style.display = 'none';
                document.getElementById('dashboard').style.display = 'block';

            }, 3000);
        }

        function renderFormTrack(containerId, formArray) {
            let html = '';
            formArray.forEach(res => {
                let cls = res === 'W' ? 'form-w' : (res === 'D' ? 'form-d' : 'form-l');
                html += `<div class="form-badge ${cls}">${res}</div>`;
            });
            document.getElementById(containerId).innerHTML = html;
        }

        function renderDashboard(hData, aData, analysis) {
            // Nomi e Rating
            document.getElementById('ui-home-name').textContent = hData.team.name.toUpperCase();
            document.getElementById('ui-home-rating').textContent = `★ ${hData.pregameForm.avgRating}`;
            document.getElementById('ui-away-name').textContent = aData.team.name.toUpperCase();
            document.getElementById('ui-away-rating').textContent = `★ ${aData.pregameForm.avgRating}`;

            // Forma
            renderFormTrack('ui-home-form', hData.pregameForm.form);
            renderFormTrack('ui-away-form', aData.pregameForm.form);

            // Barre Statistiche (Forzo un piccolo delay per animare la width)
            setTimeout(() => {
                document.getElementById('ui-home-atk-bar').style.width = `${analysis.hPower}%`;
                document.getElementById('ui-home-atk-val').textContent = `${analysis.hPower.toFixed(0)}%`;
                document.getElementById('ui-home-def-bar').style.width = `${analysis.hDef}%`;
                document.getElementById('ui-home-def-val').textContent = `${analysis.hDef.toFixed(0)}%`;

                document.getElementById('ui-away-atk-bar').style.width = `${analysis.aPower}%`;
                document.getElementById('ui-away-atk-val').textContent = `${analysis.aPower.toFixed(0)}%`;
                document.getElementById('ui-away-def-bar').style.width = `${analysis.aDef}%`;
                document.getElementById('ui-away-def-val').textContent = `${analysis.aDef.toFixed(0)}%`;
            }, 100);

            // Golden Bet
            document.getElementById('ui-prediction').textContent = analysis.prediction;
            document.getElementById('ui-conf-text').textContent = `Fiducia Algoritmo: ${analysis.confidence.toFixed(1)}%`;
            
            let circle = document.getElementById('ui-conf-circle');
            circle.className = 'conf-circle'; // reset
            if(analysis.confidence >= 75) circle.classList.add('conf-high');
            else if(analysis.confidence >= 60) circle.classList.add('conf-med');
            else circle.classList.add('conf-low');

            // Motivazioni AI
            let reasonsHtml = '';
            analysis.reasons.forEach(r => { reasonsHtml += `<li>${r}</li>`; });
            document.getElementById('ui-ai-reasons').innerHTML = reasonsHtml;
        }

    </script>
</body>
</html>
